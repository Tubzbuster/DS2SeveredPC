# Never commit EA's game files - only the text scans and our own tools.
*.exe
*.dll
*.xex
*.str
*.viv
*.big
*.toc
*.sb
*.bik
*.dds
*.bin
*.dat
*.pak
/GameFiles/
/Severed/

# Package contents extracted by the scanner
/tools/scan/extracted/

# Prebuilt probe DLL (our own code, built by tools/probe/build.sh)
!/tools/probe/bin/dinput8.dll

# Sample files exported from the games (EA data)
/tools/samples/out/
/tools/index/out/
/tools/export/out/
# .NET build output
bin/
obj/
*.pkl

# Python bytecode
__pycache__/
*.pyc

# Native build output
*.so

# Learned conversion models (byte-order rules only, no game data) and the
# prebuilt XAS encoder (our own code, built by tools/research/native/build.sh)
!/tools/research/ds2/*.pkl
!/tools/research/native/xasenc.dll

# Converter output (holds local paths)
*.log
*.addoninfo.txt
tools/app/build/
tools/app/dist/
tools/app/*.spec
tools/app/ffmpeg/
tools/research/base_sections.zip
